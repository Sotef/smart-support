# Пример переменных окружения для Smart Support

# Общие
ENVIRONMENT=development
LOG_LEVEL=INFO

# SciBox (OpenAI-совместимый API)
# ВНИМАНИЕ: не храните реальные токены в репозитории.
# Скопируйте этот файл в .env и подставьте ваш ключ локально.
SCIBOX_API_KEY=sk-YLxSK778_VZY8R4MASxg2A
SCIBOX_BASE_URL=https://llm.t1v.scibox.tech/v1
SCIBOX_EMBED_BASE_URL=https://llm.t1v.scibox.tech/v1
SCIBOX_CHAT_MODEL=Qwen2.5-72B-Instruct-AWQ
SCIBOX_EMBED_MODEL=bge-m3
# Необязательный /health (может требовать авторизацию и давать 401)
SCIBOX_URL=http://45.145.191.148:4000

# Ранжирование и эмбеддинги
USE_EMBEDDINGS=true
VECTOR_INDEX_PATH=data/kb_index.json

# База знаний (Excel)
KNOWLEDGE_BASE_XLSX=C:\\path\\to\\smart_support_vtb_belarus_faq.xlsx
# Необязательные настройки Excel-структуры
KB_SHEET=
KB_COL_TITLE=
KB_COL_CONTENT=
KB_COL_CATEGORY=
KB_COL_SUBCATEGORY=
KB_COL_TAGS=
# Мэппинг категорий Excel->модели (JSON), например: {"Оплата":"billing","Жалобы":"complaint"}
KB_CATEGORY_MAP=

# Эскалация
ESCALATE_THRESHOLD=3

# Хранилища (опционально)
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://smartsupport:password123@localhost:5432/smartsupport_db

# Безопасность
SECRET_KEY=change-me

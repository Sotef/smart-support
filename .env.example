# Пример переменных окружения для Smart Support

# Общие
ENVIRONMENT=development
LOG_LEVEL=INFO

# Интеграции
SCIBOX_URL=http://localhost:8001
# API-ключ для реального Scibox (не указывайте здесь реальные значения, используйте локальный .env)
SCIBOX_API_KEY=
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://smartsupport:password123@localhost:5432/smartsupport_db

# Безопасность
SECRET_KEY=change-me
